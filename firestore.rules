rules_version = '2';

// ============================================================
// オトン学園 Firestore セキュリティルール案
//   貼り付け先： Firebaseコンソール → Firestore Database → ルール → 公開
//   https://console.firebase.google.com/project/tuna-app-4eeab/firestore/rules
//
// 【これで防げること】
//   ・想定外のコレクション／フィールドへの書き込み（荒らし・スパム）
//   ・巨大データの書き込み（無料枠の使い切り）
//   ・ありえない値（スコア999999999・達成率200%など）の登録
//   ・他人のデータの「削除」（消し逃げ）
//
// 【防げないこと（正直に）】
//   このアプリはニックネームだけで認証が無いため、
//   「他人のニックネームを名乗って、その人の記録を上書きする」ことは
//   ルールでは防げません（サーバーが本人かどうか判定できないため）。
//   ただし上書きされても“ありえない値”は弾かれ、削除もできません。
//   完全に防ぐには各自にパスワード/PINを持たせる改修が必要です。
//
//   いけんばこ・通報も同じで、受験番号を変えながら送り続ける荒らしは止められません
//   （1日6件の上限は「受験番号ごと」なので）。根本対策は App Check ですが、
//   既存の書き込み全部に一律で効くため今回は入れていません。
//
// 【管理ツールからの削除について（2026-08-01）】
//   受験番号の削除は「管理者としてログインしているとき」だけ通ります（下の isAdmin）。
//   管理ツールに管理者ログインを付けたので、消したいときはそこから。
//   アプリ本体にはログイン画面が無いので、子どもの端末からは誰のデータも消せません。
//
//   プレゼント付与（コイン・遊び券・アイテム）は今までどおり動きます。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通ヘルパー ----------
    function nickOk(nick) {
      return nick is string && nick.size() > 0 && nick.size() <= 20;
    }
    // 時刻はサーバー時刻のみ許可（過去日付の偽装を防ぐ）
    function serverTime() {
      return request.resource.data.lastUpdated == request.time;
    }
    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }
    function strOk(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------- 学習の進捗 users/{ニックネーム}/progress/{単元} ----------
    match /users/{nick}/progress/{category} {
      allow read: if nickOk(nick);
      allow create, update: if nickOk(nick)
        && request.resource.data.keys().hasOnly(['correct', 'total', 'lastUpdated'])
        && intIn(request.resource.data.correct, 0, 200000)
        && intIn(request.resource.data.total, 0, 200000)
        && request.resource.data.correct <= request.resource.data.total
        && serverTime();
      allow delete: if isAdmin();
    }

    // ---------- 端末バックアップ users/{ニックネーム}/backup/data ----------
    // 中身はlocalStorageの文字列。progressが一番大きいので上限を厚めに。
    match /users/{nick}/backup/data {
      allow read: if nickOk(nick);
      allow create, update: if nickOk(nick)
        && request.resource.data.keys().hasOnly([
             'coins', 'items', 'gacha', 'loginBonus', 'playTime', 'titleRank',
             'tetrisBest', 'jumpBest', 'mineBest_easy', 'mineBest_normal', 'mineBest_hard',
             'mapquizBest', 'timelineBest', 'drillBest', 'progress', 'lastUpdated'
           ])
        && (!('progress' in request.resource.data)  || strOk(request.resource.data.progress, 900000))
        && (!('gacha' in request.resource.data)     || strOk(request.resource.data.gacha, 60000))
        && (!('items' in request.resource.data)     || strOk(request.resource.data.items, 20000))
        && (!('loginBonus' in request.resource.data)|| strOk(request.resource.data.loginBonus, 20000))
        && (!('coins' in request.resource.data)     || strOk(request.resource.data.coins, 200))
        // playTime は {"total":n,"byDate":{"2026-07-27":123,...}} で毎日1件ずつ増える。
        // 20文字だと最初から超える（実測393文字で permission-denied。2026-07-27に確定）。
        // 6年間毎日でも約2200日×20文字＝44,000字なので、余裕をみて 80,000。
        && (!('playTime' in request.resource.data)  || strOk(request.resource.data.playTime, 80000))
        && (!('titleRank' in request.resource.data) || strOk(request.resource.data.titleRank, 200))
        && (!('tetrisBest' in request.resource.data)|| strOk(request.resource.data.tetrisBest, 200))
        && (!('jumpBest' in request.resource.data)  || strOk(request.resource.data.jumpBest, 200))
        && (!('mineBest_easy' in request.resource.data)   || strOk(request.resource.data.mineBest_easy, 200))
        && (!('mineBest_normal' in request.resource.data) || strOk(request.resource.data.mineBest_normal, 200))
        && (!('mineBest_hard' in request.resource.data)   || strOk(request.resource.data.mineBest_hard, 200))
        && (!('mapquizBest' in request.resource.data)     || strOk(request.resource.data.mapquizBest, 200))
        && (!('timelineBest' in request.resource.data)    || strOk(request.resource.data.timelineBest, 200))
        // drillBest は {"drill_g5_mul_d3_t60":24, …} の1本。
        // 全部埋めても 6学年×8種×4難×3タイム＝576件・約1.7万字なので余裕をみて 30,000。
        && (!('drillBest' in request.resource.data)       || strOk(request.resource.data.drillBest, 30000))
        && serverTime();
      allow delete: if isAdmin();
    }

    // ---------- プレゼント付与 users/{ニックネーム}/backup/grants ----------
    // 管理ツールが加算予約を書き、アプリが読んで反映後に削除する
    // 形： { items: {bomb:2, wing:1, …}, coins: 100, tickets: 3, ts: 時刻 }
    match /users/{nick}/backup/grants {
      allow read: if nickOk(nick);
      allow delete: if nickOk(nick);       // アプリが受け取り後に消す（必須）
      allow create, update: if nickOk(nick)
        && request.resource.data.keys().hasOnly(['items', 'coins', 'tickets', 'ts'])
        && (!('coins' in request.resource.data)   || intIn(request.resource.data.coins, 0, 5000))
        && (!('tickets' in request.resource.data) || intIn(request.resource.data.tickets, 0, 100))
        && (!('items' in request.resource.data) || (
              request.resource.data.items.keys()
                .hasOnly(['bomb', 'slow', 'search', 'shield', 'wing', 'rocket'])
              && (!('bomb' in request.resource.data.items)   || intIn(request.resource.data.items.bomb, 0, 99))
              && (!('slow' in request.resource.data.items)   || intIn(request.resource.data.items.slow, 0, 99))
              && (!('search' in request.resource.data.items) || intIn(request.resource.data.items.search, 0, 99))
              && (!('shield' in request.resource.data.items) || intIn(request.resource.data.items.shield, 0, 99))
              && (!('wing' in request.resource.data.items)   || intIn(request.resource.data.items.wing, 0, 99))
              && (!('rocket' in request.resource.data.items) || intIn(request.resource.data.items.rocket, 0, 99))
           ));
    }

    // ---------- 単元別ランキング leaderboard/{単元}/scores/{ニックネーム} ----------
    match /leaderboard/{category}/scores/{nick} {
      allow read: if true;                 // ランキング表示のため誰でも読める
      allow create, update: if nickOk(nick)
        && request.resource.data.keys().hasOnly(['rate', 'correct', 'total', 'lastUpdated'])
        && intIn(request.resource.data.rate, 0, 100)
        && intIn(request.resource.data.correct, 0, 200000)
        && intIn(request.resource.data.total, 0, 200000)
        && request.resource.data.correct <= request.resource.data.total
        && serverTime();
      allow delete: if isAdmin();
    }

    // ---------- 達成率ランキング achievement/{ニックネーム} ----------
    match /achievement/{nick} {
      allow read: if true;
      allow create, update: if nickOk(nick)
        && request.resource.data.keys().hasOnly(['pct', 'cleared', 'titleIdx', 'lastUpdated'])
        && request.resource.data.pct is number
        && request.resource.data.pct >= 0
        && request.resource.data.pct <= 100
        && intIn(request.resource.data.cleared, 0, 100000)
        && intIn(request.resource.data.titleIdx, 0, 20)
        && serverTime();
      allow delete: if isAdmin();
    }

    // ---------- ゲームランキング game_scores/{ゲーム}/scores/{ニックネーム} ----------
    // 計算ドリルは「学年×種類×難易度×タイム」ごとに1本なので名前が可変。
    // 列挙できないぶん、形をきっちり決めて正規表現で縛る（2026-07-28）。
    //   例： drill_g5_mul_d3_t60
    //   タイムは 60/90/120 のみ（無制限=t0 はランキング対象外なので許可しない）
    function drillGameOk(game) {
      return game.matches('^drill_g[1-6]_(add|sub|mul|div|divrem|decimal|fraction|mix)_d[1-4]_t(60|90|120)$');
    }
    match /game_scores/{game}/scores/{nick} {
      allow read: if true;
      allow create, update: if nickOk(nick)
        && (game in ['tetris', 'jump', 'mine_easy', 'mine_normal', 'mine_hard'] || drillGameOk(game))
        && request.resource.data.keys().hasOnly(['value', 'lastUpdated'])
        && intIn(request.resource.data.value, 0, 10000000)
        && serverTime();
      allow delete: if isAdmin();
    }

    // ---------- 管理者（管理ツール）の判定 ----------
    // 管理ツール（Desktop\オトン学園管理ツール\index.html）だけが、
    // Firebase Auth の「メール／パスワード」でこのアカウントにログインできる。
    // アプリ本体にはログイン画面が無いので、削除できるのは管理ツールからだけ。
    //
    //   ★ここのメールアドレスは、Firebaseコンソールの
    //     Authentication → Users で先に作っておくこと。
    //     先に作っておけば、他人が同じメールでアカウントを作ることはできない（＝なりすませない）。
    //     パスワードを知っているのは本人だけ。
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['kayano.tadanori@gmail.com'];
    }

    // ---------- フィードバック feedback/{ID} ----------
    // 【なにが入るか】
    //   ・クイズ中の「この問題おかしい」通報（kind='question'）
    //   ・いけんばこからの要望・不具合（kind='idea'）
    //
    // 【読めるのは管理者だけ】
    //   子どもが書いた自由文なので、achievement のように誰でも読める形にはしない。
    //   アプリ側の「おくったもの」一覧は localStorage から出しているので読み取り不要。
    //
    // 【1日6件までの作り】
    //   ドキュメントIDを 20260816_たろう_0 の形に固定し、末尾の連番を 0〜5 に縛る。
    //   create しか許さない＝同じIDには2度書けないので、受験番号ごとに1日6件が上限になる。
    //   （カウンタを持つ仕組みがルールには無いので、IDの形で数えている）
    function fbIdOk(id) {
      return id.matches('^20[0-9]{6}_.{1,20}_[0-5]$');
    }
    // 任意フィールド用。「無いならOK、あるなら長さを見る」
    function fbStr(field, maxLen) {
      return !(field in request.resource.data) || strOk(request.resource.data[field], maxLen);
    }

    match /feedback/{fid} {
      allow read: if isAdmin();
      allow create: if fbIdOk(fid)
        && nickOk(request.resource.data.nickname)
        && request.resource.data.keys().hasAll(['kind', 'reason', 'nickname', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly([
             'kind', 'reason', 'comment', 'nickname', 'status', 'createdAt',
             'qid', 'subject', 'cat', 'unit', 'grade', 'difficulty',
             'question', 'answer', 'screen', 'ver', 'ua'
           ])
        && request.resource.data.kind in ['question', 'idea']
        && request.resource.data.reason in
             ['answer', 'text', 'kaisetsu', 'level', 'request', 'bug', 'other']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && fbStr('comment', 500)
        && fbStr('qid', 60)
        && fbStr('subject', 12)
        && fbStr('cat', 24)
        && fbStr('unit', 40)
        && fbStr('difficulty', 12)
        && fbStr('question', 200)
        && fbStr('answer', 60)
        && fbStr('screen', 24)
        && fbStr('ver', 24)
        && fbStr('ua', 160)
        && (!('grade' in request.resource.data) || intIn(request.resource.data.grade, 0, 6));
      // 未読／対応済みの切替と管理メモは管理ツールから（管理者ログイン中だけ）。
      // affectedKeys で縛ってあるので、管理ツールのバグで本文を壊すことはない。
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'adminNote', 'handledAt'])
        && request.resource.data.status in ['new', 'doing', 'done']
        && fbStr('adminNote', 500);
      allow delete: if isAdmin();
    }

    // ---------- 上記以外はすべて拒否 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================
// 【管理者ログインの準備（このルールを公開する前に1回だけ）】
//   1. Firebaseコンソール → Authentication → 「始める」
//   2. Sign-in method → 「メール／パスワード」を有効にする（下のGoogleは不要）
//   3. Users → 「ユーザーを追加」→ 上の isAdmin に書いたメールアドレスと、
//      好きなパスワードを登録する
//   4. このルールを公開
//   5. 管理ツールを開いて「管理者ログイン」→ 3で決めたメール／パスワード
//      （一度入れればブラウザに残るので、毎回打つ必要はありません）
//
//   ※ 2 を有効にすると「誰でも自分のアカウントを作れる」状態にはなりますが、
//     削除できるのは isAdmin のメールだけ。そのメールは3で先に押さえてあるので
//     他人は作れません。
// ============================================================
