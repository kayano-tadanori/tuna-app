{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Origami recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "work", "paper", "coordinates", "steps"],
  "properties": {
    "format": {"const": "origami-recipe"},
    "version": {"const": 1},
    "coordinates": {"const": "unfolded-normalized-xy"},
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "emoji", "difficulty"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "emoji": {"type": "string", "minLength": 1, "maxLength": 20},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {"image": {"type": "string"}, "note": {"type": "string"}}
    },
    "paper": {
      "type": "object", "additionalProperties": false,
      "required": ["aspectRatio", "colorDown"],
      "properties": {
        "aspectRatio": {"type": "number", "minimum": 0.1, "maximum": 10},
        "colorDown": {"type": "boolean"}
      }
    },
    "steps": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["faceId"],
      "properties": {
        "faceId": {"type": "string", "minLength": 1, "maxLength": 8192},
        "layerPath": {
          "type": "array", "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["stepId", "side"],
            "properties": {"stepId": {"$ref": "#/$defs/id"}, "side": {"enum": ["keep", "cut"]}}
          }
        }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "diagramStep", "op", "instruction"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "diagramStep": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 2000},
        "op": {"enum": ["fold", "crease", "flip", "reverse"]},
        "axis": {"enum": ["v", "h"]},
        "kind": {"enum": ["V", "M"]},
        "reference": {"$ref": "#/$defs/ref"},
        "line": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}},
        "movingSidePoint": {"$ref": "#/$defs/point"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/ref"}},
        "hinge": {"type": "object", "additionalProperties": false, "required": ["stepId", "faceIds", "seg"], "properties": {"stepId": {"$ref": "#/$defs/id"}, "faceIds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 8192}}, "seg": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}}}}
      },
      "oneOf": [
        {"properties": {"op": {"const": "flip"}, "kind": false, "reference": false, "line": false, "movingSidePoint": false, "targets": false, "hinge": false}, "required": ["axis"]},
        {"properties": {"op": {"enum": ["fold", "crease"]}, "axis": false, "hinge": false}, "required": ["kind", "reference", "line", "movingSidePoint", "targets"]},
        {"properties": {"op": {"const": "reverse"}, "axis": false, "kind": false}, "required": ["reference", "line", "movingSidePoint", "targets", "hinge"]}
      ]
    }
  }
}
